# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Email notification (sent to the Centre team on each new application) ---
# Works with any SMTP provider. For Gmail: host smtp.gmail.com, port 587,
# and SMTP_PASSWORD is a 16-character Google "App Password" (not your login
# password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of recipients who get notified of new applications
NOTIFY_EMAIL_TO=

# --- Google Sheets logging (each application is appended as a row) ---
# Uses a Google Apps Script Web App bound to the Sheet — no Google Cloud
# project or service account needed. See setup steps in the project docs.
# The deployment URL ends in /exec
GOOGLE_APPS_SCRIPT_URL=
# Any random string — must match the SECRET constant inside the Apps Script
GOOGLE_APPS_SCRIPT_SECRET=

# --- Direct Google Sheets access (optional, but makes every save/load fast) ---
# A service account reads and writes the sheet through Google's Sheets API
# instead of through the slow Apps Script above (which is then only used for
# photo uploads). Setup: scripts/apps-script/README.md, "Direct Sheets access".
# Check it with: node scripts/check-google-sheets.mjs
# The long id in the sheet's address (docs.google.com/spreadsheets/d/<THIS>/edit)
GOOGLE_SHEET_ID=
# The service account's key file, on ONE line, inside single quotes:
#   GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Fast photo storage (optional): Vercel Blob ---
# Saves photos in well under a second instead of the 4-60s the Drive route
# takes. Created for you when a Blob store is connected to the project in Vercel
# (Storage tab); see scripts/apps-script/README.md, "Fast photo storage".
BLOB_READ_WRITE_TOKEN=

# --- Faculty portal (/staff) ---
# Signs the faculty login session cookie. Long random string — treat it like
# a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See scripts/apps-script/README.md for the full faculty portal setup
# (sheet tabs, Drive folder, first account).
SESSION_SECRET=
