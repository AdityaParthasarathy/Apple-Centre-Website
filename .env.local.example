# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Email notification (sent to the Centre team on each new application) ---
# Works with any SMTP provider. For Gmail: host smtp.gmail.com, port 587,
# and SMTP_PASSWORD is a 16-character Google "App Password" (not your login
# password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of recipients who get notified of new applications
NOTIFY_EMAIL_TO=

# --- Google Sheets logging (each application is appended as a row) ---
# Uses a Google Apps Script Web App bound to the Sheet — no Google Cloud
# project or service account needed. See setup steps in the project docs.
# The deployment URL ends in /exec
GOOGLE_APPS_SCRIPT_URL=
# Any random string — must match the SECRET constant inside the Apps Script
GOOGLE_APPS_SCRIPT_SECRET=

# --- Faculty portal (/staff) ---
# Signs the faculty login session cookie. Long random string — treat it like
# a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See scripts/apps-script/README.md for the full faculty portal setup
# (sheet tabs, Drive folder, first account).
SESSION_SECRET=
